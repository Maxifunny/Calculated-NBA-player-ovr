# Copy to .env and edit. Defaults work with the bundled SQLite warehouse.

NBA_SEASON=2025-26
NBA_2K_VERSION=2K26
MIN_GAMES=15
MIN_MPG=10

# 0 = every regular-season game. Start with 80 on a home network.
PBP_MAX_GAMES=80
PBP_SLEEP_SECONDS=0.7
NBA_API_TIMEOUT=60

# SQLite (default, no Docker):
# DATABASE_URL=sqlite:///warehouse/nba_ovr.sqlite
#
# PostgreSQL (after `docker compose up -d`):
# DATABASE_URL=postgresql+psycopg2://nba:nba@localhost:5432/nba_ovr

SPARK_DRIVER_MEMORY=2g
